{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_TEST",
        "REDIS_URL",
        "JWT_*",
        "DATA_ENCRYPTION_KEY",
        "S3_*",
        "SMTP_*",
        "FFMPEG_PATH",
        "FFPROBE_PATH"
      ],
      "cache": false
    }
  }
}
