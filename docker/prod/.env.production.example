# Copie para docker/prod/.env na VPS e preencha. NUNCA commite o .env.
# Segredos: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Usados pelo docker compose (postgres, rustfs) e pela API ----------------
POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=faixacerta
S3_SECRET_ACCESS_KEY=

# --- API ---------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
API_PUBLIC_URL=https://app-faixacerta.com.br
WEB_APP_URL=https://app-faixacerta.com.br
CORS_ORIGINS=https://app-faixacerta.com.br
MOBILE_DEEP_LINK_SCHEME=faixacerta
QUEUE_DRIVER=bullmq

JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=

GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=faixacerta,br.com.faixacerta.app

# Storage: URLs assinadas e mídia pública pelo subdomínio s3
S3_PUBLIC_ENDPOINT=https://s3.app-faixacerta.com.br
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=faixa-certa-public
S3_BUCKET_PRIVATE=faixa-certa-private
S3_AUTO_CREATE_BUCKETS=true
CDN_PUBLIC_BASE_URL=https://s3.app-faixacerta.com.br/faixa-certa-public

# E-mail: configure um SMTP real (Resend, SES, Brevo...). Sem isso, e-mails não são entregues.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Faixa Certa <nao-responda@app-faixacerta.com.br>"

ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

SENTRY_DSN=
