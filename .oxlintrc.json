{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "no-console": "warn",
    "import/no-cycle": "error",
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }],
    "import/no-unassigned-import": ["warn", { "allow": ["reflect-metadata", "dotenv/config"] }],
    "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "**.expect"] }]
  },
  "overrides": [
    {
      "files": ["**/prisma/seed/**", "**/src/cli/**"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["**/test/setup-env.ts"],
      "rules": { "import/no-unassigned-import": "off" }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "src/generated", "**/schema.d.ts"]
}
