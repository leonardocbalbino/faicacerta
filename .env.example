# =============================================================================
# Faixa Certa — variáveis de ambiente
# Copie para apps/api/.env (a API lê de lá) e ajuste os valores.
# =============================================================================

# --- Geral -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# URL pública da API (usada em links de e-mail e deep links)
API_PUBLIC_URL=http://localhost:3000
# Origens permitidas no CORS (painel web), separadas por vírgula
CORS_ORIGINS=http://localhost:5173
# URL do painel web (links de verificação de e-mail e redefinição de senha)
WEB_APP_URL=http://localhost:5173
# Esquema de deep link do app mobile
MOBILE_DEEP_LINK_SCHEME=faixacerta
LOG_LEVEL=debug

# --- Banco de dados ----------------------------------------------------------
DATABASE_URL=postgresql://faixacerta:faixacerta@localhost:5432/faixacerta
DATABASE_URL_TEST=postgresql://faixacerta:faixacerta@localhost:5432/faixacerta_test

# --- Redis (BullMQ, rate limit) ---------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Autenticação ------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=faixa-certa-api
JWT_AUDIENCE=faixa-certa

# Google: IDs de cliente OAuth aceitos como audience do id_token (iOS, Android e Web)
GOOGLE_CLIENT_IDS=
# Apple: bundle id do app iOS e service id (Sign in with Apple na web)
APPLE_CLIENT_IDS=br.com.faixacerta.app

# --- E-mail (Mailpit em desenvolvimento) -------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Faixa Certa <nao-responda@faixacerta.local>"

# --- Armazenamento S3 (RustFS em desenvolvimento) ----------------------------
S3_ENDPOINT=http://localhost:9000
# Endpoint usado nas URLs assinadas entregues ao app. Para testar no celular,
# use o IP da máquina na rede (ex.: http://192.168.0.10:9000).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=faixacerta-dev
S3_SECRET_ACCESS_KEY=faixacerta-dev-secret-2026
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=faixa-certa-public
S3_BUCKET_PRIVATE=faixa-certa-private
# Cria os buckets e a policy pública ao subir (padrão: ligado fora de produção)
S3_AUTO_CREATE_BUCKETS=
# URL da CDN na frente do bucket público (em dev, o próprio storage)
CDN_PUBLIC_BASE_URL=http://localhost:9000/faixa-certa-public
SIGNED_URL_TTL_SECONDS=900
UPLOAD_URL_TTL_SECONDS=900

# --- Fila e processamento de mídia --------------------------------------------
# bullmq (Redis) ou inline (executa na hora; só para testes e scripts)
QUEUE_DRIVER=bullmq
# Esta instância processa jobs? Em produção: API=false e worker=true.
WORKERS_ENABLED=true
# ffmpeg/ffprobe do sistema (Windows: winget install Gyan.FFmpeg)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Criptografia de segredos no banco (credenciais do gateway, CPF) --------
# 32 bytes em base64. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# --- Pagamentos (Asaas) ------------------------------------------------------
# As credenciais de produção ficam criptografadas no banco e são editadas no painel.
# Estas variáveis servem só para o primeiro boot e para os testes com o sandbox.
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=

# --- Seeds -------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@faixacerta.local
SEED_ADMIN_PASSWORD=Admin@12345

# --- Observabilidade ---------------------------------------------------------
SENTRY_DSN=
