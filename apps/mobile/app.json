{
  "expo": {
    "name": "Faixa Certa",
    "slug": "faixa-certa",
    "scheme": "faixacerta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "primaryColor": "#D4FF3A",
    "description": "Apostila digital por faixa para o exame de graduação no judô.",
    "ios": {
      "bundleIdentifier": "faixacerta",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "br.com.faixacerta.app",
      "adaptiveIcon": {
        "backgroundColor": "#D4FF3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "permissions": ["android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D4FF3A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-system-ui",
      "expo-asset",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Faixa Certa usa suas fotos só para montar o card da sua conquista. Nada é enviado aos nossos servidores.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O Faixa Certa usa suas fotos só para montar o card da sua conquista.",
          "savePhotosPermission": "O Faixa Certa salva na sua galeria o card da conquista que você criou.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6350645959394447~5874493727",
          "iosAppId": "ca-app-pub-6350645959394447~8511818243"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6b00f197-38b5-40ee-96ce-3f61b26eda0b"
      }
    },
    "owner": "leonardocbalbino",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6b00f197-38b5-40ee-96ce-3f61b26eda0b"
    }
  }
}
